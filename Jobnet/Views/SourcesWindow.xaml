<Window x:Class="Jobnet.Views.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jobnet.ViewModels"
        Title="Jobnet — Sources"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sources" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SummaryLine}" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Padding="14,4" Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Filter row -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Type:" Foreground="#666" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding KindOptions}"
                          SelectedItem="{Binding SelectedKind}"
                          DisplayMemberPath="Label"
                          MinWidth="130" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Size:" Foreground="#666" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding SizeOptions}"
                          SelectedItem="{Binding SelectedSize}"
                          DisplayMemberPath="Label"
                          MinWidth="170" Margin="0,0,16,0"
                          ToolTip="Companies only — size buckets are derived from the AI profile's employee-count hint."/>

                <TextBox Grid.Column="4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" BorderBrush="#CCC"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- List -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding View}"
                 BorderBrush="#DDD"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#EEE"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SourceRow}">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Kind chip -->
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                Background="#F0F4F8" CornerRadius="3"
                                Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#1976D2"/>
                        </Border>

                        <!-- Name (links open the URL via the row's OpenLinkCommand) -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <Hyperlink Command="{Binding OpenLinkCommand}"
                                       ToolTip="{Binding Url}">
                                <Run Text="{Binding Name}"/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Grid.Column="1" Grid.Row="1"
                                   Text="{Binding Url}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#1976D2"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="2"
                                   Text="{Binding Secondary}"
                                   FontSize="11" Foreground="#888"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Secondary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Secondary}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Size chip (companies only) -->
                        <Border Grid.Column="2" Grid.Row="0"
                                Background="#F5F5F5" CornerRadius="3"
                                Padding="6,3" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SizeCategory}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="#555"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="14,4" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
