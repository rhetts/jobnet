<Window x:Class="Jobnet.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jobnet.ViewModels"
        Title="Jobnet — Monitor"
        Width="780" Height="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Monitor" FontSize="16" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="Refresh" Padding="14,4" Command="{Binding RefreshCommand}"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <!-- TAB 1: STATS -->
            <TabItem Header="Stats">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel>
                        <!-- COMPANIES -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Companies"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Active"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding CompaniesActive}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Inactive (retired)"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding CompaniesInactive}" Foreground="#888"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Total"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding CompaniesTotal}"/>
                            </Grid>
                        </Border>

                        <!-- JOBS -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Jobs"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Active"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding JobsActive}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Removed (no longer in source ATS)"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding JobsRemoved}" Foreground="#888"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Total"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding JobsTotal}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Active jobs with AI summary"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding JobsWithSummary}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource MetricLabel}" Text="Active jobs with resume score"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetricValue}" Text="{Binding JobsWithResumeMatch}"/>
                            </Grid>
                        </Border>

                        <!-- QUEUE -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Background queue"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3" Padding="12,8">
                            <StackPanel>
                                <TextBlock Foreground="#888" FontSize="11" Margin="0,0,0,6"
                                           Text="Workers run continuously while Jobnet is open. Pending rows drain at the configured poll interval."/>
                                <ItemsControl ItemsSource="{Binding Queue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QueueRow}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TaskType}" FontFamily="Consolas" FontSize="11" Foreground="#444"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}"   FontFamily="Consolas" FontSize="11" Foreground="#666"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}"    FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="(queue is empty)" Foreground="#888" FontStyle="Italic" FontSize="11" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border BorderBrush="#EEE" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="Some unscored jobs have terminal queue rows (status 'failed' or 'completed' with no score) and won't be retried on their own. Use this to reset them and let the worker try again."/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Rescore stuck jobs"
                                                    Command="{Binding RescoreStuckJobsCommand}"
                                                    Padding="12,4"/>
                                            <TextBlock Text="{Binding RescoreStatus}"
                                                       Foreground="#444"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PARSER SYSTEM BREAKDOWN -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Companies by extraction system"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding ParserSystems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ParserSystemRow}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding System}" FontFamily="Consolas" FontSize="11" Foreground="#444"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}"  FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: API USAGE — bound to the nested ApiUsage VM -->
            <TabItem Header="API usage" DataContext="{Binding ApiUsage}">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LastRefreshed}" Foreground="#888" FontSize="11"/>
                        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="RPM = requests in the last 60s · RPD = requests today (UTC) · TPD = AI tokens today (UTC). Green &lt;70% of cap, amber 70-90%, red ≥90%. Caps come from api_rpm_cap.* / api_soft_cap.* / api_tpd_cap.* config keys; set 0 to disable a dimension."/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProviderUsageTile}">
                                    <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                                            Padding="12,10" Margin="0,0,0,8" CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Provider}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="#888">
                                                    <Run Text="last call "/>
                                                    <Run Text="{Binding LastCall, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="RPM (last 60s)" Foreground="#666" FontSize="11"/>
                                                    <TextBlock Text="{Binding Rpm}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,4"
                                                               Foreground="{Binding RpmStatusBrush}"/>
                                                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding RpmFraction, Mode=OneWay}"
                                                                 Foreground="{Binding RpmStatusBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="RPD (today)" Foreground="#666" FontSize="11"/>
                                                    <TextBlock Text="{Binding Rpd}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,4"
                                                               Foreground="{Binding RpdStatusBrush}"/>
                                                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding RpdFraction, Mode=OneWay}"
                                                                 Foreground="{Binding RpdStatusBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                    <TextBlock Text="TPD (today)" Foreground="#666" FontSize="11"/>
                                                    <TextBlock Text="{Binding Tpd}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,4"
                                                               Foreground="{Binding TpdStatusBrush}"/>
                                                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding TpdFraction, Mode=OneWay}"
                                                                 Foreground="{Binding TpdStatusBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- TAB 3: LOG — tails the last ~500 lines of jobnet.log -->
            <TabItem Header="Log">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LogPath}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#666"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding LogPath}"/>
                        <Button Grid.Column="1"
                                Content="Open folder"
                                Command="{Binding OpenLogFolderCommand}"
                                Padding="10,3"/>
                    </Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Padding="8"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="14,4" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
